<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.lyj.dao.User_HotUrlDao">


    <delete id="deleteUser_HotUrlByUrlIdBatch">
        DELETE from user_hotUrl where likeUrlId in
        <foreach collection="list" item="itemId" index="no" open="(" close=")" separator=",">
            #{itemId}
        </foreach>
</delete>


</mapper>